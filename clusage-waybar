#!/usr/bin/env python3
"""clusage-waybar -- Claude Code usage indicator for Waybar.

Reads the OAuth token Claude Code stores in ~/.claude/.credentials.json, calls
the same usage endpoint the `/usage` panel uses (api.anthropic.com/api/oauth/usage),
and prints a Waybar JSON object: {text, tooltip, class, percentage}.

The bar text shows session (5h) and weekly (all-models) utilization. The tooltip
adds the per-model weekly breakdown (Sonnet / Opus) and reset times.

Successful responses are cached to ~/.cache/clusage/usage.json so a transient
network/API failure shows the last known value (dimmed) instead of going blank.
"""

import json
import os
import sys
import time

# Import the shared API helpers next to the real script, not next to the
# symlink this is usually invoked through (~/.local/bin/clusage-waybar).
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from clusage_api import (  # noqa: E402
    fetch_usage,
    fmt_iso,
    get_access_token,
    pct,
    read_cache,
    time_until,
    write_cache,
)

ICON = "\U000f06a9"  # nf-md-robot 󰚩


def fmt_reset(block, weekly=False):
    return fmt_iso((block or {}).get("resets_at"), weekly)


def model_limits(usage):
    """Per-model weekly caps from the `limits` array (e.g. Fable).

    The API moved model-scoped utilization out of the old seven_day_<model>
    fields into `limits[]`, where each model cap carries scope.model.display_name.
    Returns [{name, pct, resets_at, active}], highest utilization first.
    """
    out = []
    for lim in usage.get("limits") or []:
        model = (lim.get("scope") or {}).get("model") or {}
        name = model.get("display_name")
        if not name:
            continue
        out.append(
            {
                "name": name,
                "pct": lim.get("percent"),
                "resets_at": lim.get("resets_at"),
                "active": bool(lim.get("is_active")),
            }
        )
    out.sort(key=lambda m: (m["pct"] is None, -(m["pct"] or 0)))
    return out


def severity_class(p):
    if p is None:
        return "unknown"
    if p >= 90:
        return "critical"
    if p >= 75:
        return "high"
    if p >= 50:
        return "medium"
    return "low"


def build_output(usage, fetched_at, stale=False):
    five = usage.get("five_hour")
    week = usage.get("seven_day")
    sonnet = usage.get("seven_day_sonnet")
    opus = usage.get("seven_day_opus")
    models = model_limits(usage)

    sp = pct(five)
    wp = pct(week)

    def n(p):
        return "--" if p is None else f"{p:.0f}%"

    text = f"{ICON} {n(sp)}·{n(wp)}"
    # Surface per-model caps (e.g. Fable) right in the bar, abbreviated.
    # Don't gate on is_active: the API flips it off once the cap stops being
    # the binding one (e.g. right after a weekly reset), but we still want it visible.
    for m in models:
        if m["pct"] is not None:
            text += f"·{m['name'][0]}{m['pct']:.0f}%"
    left = time_until(five)
    if left:
        text += f" \U000f0150 {left}"  # nf-md-timer-sand 󰅐-ish clock 󰥐

    # Tooltip (pango markup).
    lines = ["<b>Claude Code usage</b>", ""]
    rows = [
        ("Session (5h)", sp, fmt_reset(five)),
        ("Weekly (all)", wp, fmt_reset(week, weekly=True)),
    ]
    for label, p, reset in rows:
        pp = "--" if p is None else f"{p:5.1f}%"
        rs = f"  resets {reset}" if reset else ""
        lines.append(f"{label:<14}{pp}{rs}")

    # Per-model weekly caps (Fable, plus Sonnet/Opus if the API still sends them).
    sub = []
    seen = set()
    for m in models:
        sub.append((f"  {m['name']}", m["pct"], fmt_iso(m["resets_at"], weekly=True), m["active"]))
        seen.add(m["name"].lower())
    for label, blk in (("Sonnet", sonnet), ("Opus", opus)):
        if blk is not None and label.lower() not in seen:
            sub.append((f"  {label}", pct(blk), fmt_reset(blk, weekly=True), False))
    for label, p, reset, active in sub:
        pp = "--" if p is None else f"{p:5.1f}%"
        rs = f"  resets {reset}" if reset else ""
        mark = "  ◀" if active else ""  # ◀ marks the currently binding cap
        lines.append(f"<small>{label:<14}{pp}{rs}{mark}</small>")
    extra = usage.get("extra_usage")
    if extra and extra.get("is_enabled"):
        used = extra.get("used_credits")
        limit = extra.get("monthly_limit")
        cur = extra.get("currency", "")
        if used is not None and limit:
            lines.append("")
            lines.append(
                f"<small>Overage      {used:.0f}/{limit:.0f} {cur} credits</small>"
            )

    lines.append("")
    upd = time.strftime("%H:%M", time.localtime(fetched_at)) if fetched_at else "?"
    suffix = "  (stale)" if stale else ""
    lines.append(f"<small>updated {upd}{suffix}</small>")
    tooltip = "\n".join(lines)

    # Worst of session / weekly / per-model caps drives color + percentage.
    worst_vals = [p for p in (sp, wp) if p is not None]
    worst_vals += [m["pct"] for m in models if m["pct"] is not None]
    worst = max(worst_vals, default=None)
    cls = severity_class(worst)
    if stale:
        cls = cls + " stale"
    out = {"text": text, "tooltip": tooltip, "class": cls}
    if worst is not None:
        out["percentage"] = round(worst)
    return out


def main():
    try:
        token = get_access_token()
        usage = fetch_usage(token)
        write_cache(usage)
        print(json.dumps(build_output(usage, int(time.time()))))
        return
    except Exception as e:
        cached = read_cache()
        if cached and cached.get("usage"):
            out = build_output(cached["usage"], cached.get("fetched_at"), stale=True)
            print(json.dumps(out))
            return
        # No data at all.
        print(
            json.dumps(
                {
                    "text": f"{ICON} --",
                    "tooltip": f"Claude Code usage unavailable\n<small>{type(e).__name__}: {e}</small>",
                    "class": "unknown error",
                }
            )
        )


if __name__ == "__main__":
    main()
